{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://romulus.local/architecture/schema.json",
  "title": "Romulus Source Document",
  "description": "Behavior-first source contract for Romulus MVP.",
  "type": "object",
  "required": [
    "version",
    "entries"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version must remain 1 unless explicitly approved."
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceEntry"
      }
    }
  },
  "$defs": {
    "sourceEntry": {
      "type": "object",
      "required": [
        "displayName",
        "subfolder",
        "torrents"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*",
          "description": "Human-readable name shown on Home."
        },
        "subfolder": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*",
          "description": "Output subfolder relative to selected download directory."
        },
        "path": {
          "default": "/",
          "description": "Optional torrent-internal path. If omitted, null, or blank, behavior defaults to root (/). Non-root directory scope must end in /. Exact file paths are allowed only for .zip archive-selection behavior; other exact file paths are rejected.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^\\s*$"
            },
            {
              "type": "string",
              "pattern": "^/$"
            },
            {
              "type": "string",
              "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+/$"
            },
            {
              "type": "string",
              "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.zip$"
            }
          ]
        },
        "torrents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/torrent"
          }
        },
        "rename": {
          "$ref": "#/$defs/rename",
          "description": "Optional rename rule. If omitted, no rename behavior is applied for this entry."
        },
        "unarchive": {
          "type": "boolean",
          "default": false,
          "description": "Optional archive extraction flag for this entry. If omitted, behavior defaults to false."
        },
        "recursiveUnarchive": {
          "type": "boolean",
          "default": false,
          "description": "Optional recursive archive extraction flag for this entry. If omitted, behavior defaults to false. Only applies when unarchive behavior is enabled for queued files."
        },
        "ignore": {
          "$ref": "#/$defs/ignore"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "recursiveUnarchive"
            ]
          },
          "then": {
            "required": [
              "unarchive"
            ],
            "properties": {
              "unarchive": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "torrent": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^magnet:\\?.+",
          "description": "Magnet link for torrent source."
        },
        "partName": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "rename": {
      "type": "object",
      "description": "Entry rename rule. Property is optional at the source-entry level; if present, both pattern and replacement are required.",
      "required": [
        "pattern",
        "replacement"
      ],
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "replacement": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        }
      }
    },
    "ignore": {
      "type": "object",
      "properties": {
        "glob": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
