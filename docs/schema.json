{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://romulus.local/architecture/schema.json",
  "title": "Romulus Source Document",
  "description": "Behavior-first source contract for Romulus MVP.",
  "type": "object",
  "required": [
    "version",
    "entries"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version must remain 1 unless explicitly approved."
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceEntry"
      }
    }
  },
  "$defs": {
    "sourceEntry": {
      "type": "object",
      "required": [
        "displayName",
        "subfolder",
        "torrents"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*",
          "description": "Human-readable name shown on Home."
        },
        "subfolder": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*",
          "description": "Output subfolder relative to selected download directory."
        },
        "scope": {
          "$ref": "#/$defs/sourceScope",
          "description": "Optional torrent-internal selection scope. If omitted, behavior defaults to shallow root scope (/ with includeNestedFiles false)."
        },
        "torrents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/torrent"
          }
        },
        "rename": {
          "$ref": "#/$defs/rename",
          "description": "Optional rename rule. If omitted, no rename behavior is applied for this entry."
        },
        "unarchive": {
          "$ref": "#/$defs/unarchive",
          "description": "Optional unarchive policy. If present, Files shows unarchive controls, the main unarchive toggle defaults on, and layout must be declared explicitly."
        },
        "ignore": {
          "$ref": "#/$defs/ignore"
        }
      },
      "additionalProperties": false
    },
    "sourceScope": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "description": "Torrent-internal scope path. Root is /. Non-root directory scope must end in /. Exact file paths are allowed only for .zip archive-selection behavior; other exact file paths are rejected.",
          "type": "string",
          "anyOf": [
            {
              "pattern": "^/$"
            },
            {
              "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+/$"
            },
            {
              "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.zip$"
            }
          ]
        },
        "includeNestedFiles": {
          "type": "boolean",
          "default": false,
          "description": "Optional descendant-file inclusion flag. If omitted, only files directly inside scope.path are eligible."
        }
      },
      "additionalProperties": false
    },
    "torrent": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^magnet:\\?.+",
          "description": "Magnet link for torrent source."
        },
        "partName": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "rename": {
      "type": "object",
      "description": "Entry rename rule. Property is optional at the source-entry level; if present, both pattern and replacement are required.",
      "required": [
        "pattern",
        "replacement"
      ],
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "replacement": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        }
      }
    },
    "unarchive": {
      "type": "object",
      "required": [
        "layout"
      ],
      "properties": {
        "recursive": {
          "type": "boolean",
          "default": false,
          "description": "Optional recursive archive extraction default. If omitted, behavior defaults to false."
        },
        "layout": {
          "$ref": "#/$defs/unarchiveLayout"
        }
      },
      "additionalProperties": false
    },
    "unarchiveLayout": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "flat",
            "dedicatedFolder"
          ]
        },
        "rename": {
          "$ref": "#/$defs/rename",
          "description": "Optional rename rule for the dedicated extract folder name."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "flat"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "rename"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "ignore": {
      "type": "object",
      "properties": {
        "glob": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
